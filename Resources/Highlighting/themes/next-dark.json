{
  "name": "next-dark",
  "displayName": "Next Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1E1F22",
    "editor.foreground": "#BCBEC4"
  },
  "tokenColors": [
    { "settings": { "foreground": "#BCBEC4", "background": "#1E1F22" } },
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7A7E85" } },
    { "scope": ["comment.block.documentation", "comment.block.javadoc", "comment.block.documentation punctuation.definition.comment"], "settings": { "foreground": "#5F826B" } },
    { "scope": ["comment.block.documentation keyword", "comment.block.documentation storage.type", "keyword.other.phpdoc", "storage.type.class.jsdoc", "storage.type.class.phpdoc"], "settings": { "foreground": "#67A37C" } },
    { "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#6AAB73" } },
    { "scope": ["constant.character.escape", "constant.character.entity", "string.regexp"], "settings": { "foreground": "#CF8E6D" } },
    { "scope": ["constant.numeric", "constant.other.color"], "settings": { "foreground": "#2AACB8" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "keyword.other.use", "keyword.other.namespace", "constant.language", "variable.language", "support.type.primitive", "keyword.type"], "settings": { "foreground": "#CF8E6D" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#BCBEC4" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "entity.name.method"], "settings": { "foreground": "#56A8F5" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.class", "support.type", "entity.name.namespace", "support.other.namespace"], "settings": { "foreground": "#BCBEC4" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.property-name", "variable.other.member", "entity.name.variable.field"], "settings": { "foreground": "#C77DBB" } },
    { "scope": ["variable.other.constant", "variable.other.enummember", "constant.other", "entity.name.constant", "support.constant"], "settings": { "foreground": "#C77DBB", "fontStyle": "italic" } },
    { "scope": ["variable.other.php", "variable.parameter"], "settings": { "foreground": "#BCBEC4" } },
    { "scope": ["meta.decorator", "meta.attribute", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation", "meta.annotation", "entity.other.attribute-name.pragma.preprocessor"], "settings": { "foreground": "#B3AE60" } },
    { "scope": ["entity.name.tag", "meta.tag.sgml", "punctuation.definition.tag"], "settings": { "foreground": "#D5B778" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#BABABA" } },
    { "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.name.tag.css", "entity.other.attribute-name.pseudo-class.css"], "settings": { "foreground": "#D5B778" } },
    { "scope": ["support.type.property-name", "support.type.property-name.css", "support.type.vendored.property-name"], "settings": { "foreground": "#BCBEC4" } },
    { "scope": ["support.constant.property-value", "support.constant.font-name", "keyword.other.unit"], "settings": { "foreground": "#6AAB73" } },
    { "scope": ["support.type.property-name.json", "string.json support.type.property-name", "meta.object-literal.key", "entity.name.tag.yaml", "keyword.key.toml", "support.type.property-name.toml", "entity.name.section.group-title.ini", "keyword.other.definition.ini", "variable.other.env"], "settings": { "foreground": "#C77DBB" } },
    { "scope": ["markup.heading", "entity.name.section", "markup.heading punctuation.definition.heading"], "settings": { "foreground": "#CF8E6D", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#6AAB73" } },
    { "scope": ["markup.underline.link", "string.other.link", "meta.link"], "settings": { "foreground": "#548AF7" } },
    { "scope": ["markup.list punctuation.definition.list", "beginning.punctuation.definition.list"], "settings": { "foreground": "#CF8E6D" } },
    { "scope": ["markup.inserted", "punctuation.definition.inserted"], "settings": { "foreground": "#73C27A" } },
    { "scope": ["markup.deleted", "punctuation.definition.deleted"], "settings": { "foreground": "#E5736F" } },
    { "scope": ["markup.changed", "meta.diff.range", "meta.diff.header"], "settings": { "foreground": "#6EA4F7" } },
    { "scope": ["variable.other.readwrite.shell", "variable.other.normal.shell", "punctuation.definition.variable.shell"], "settings": { "foreground": "#C77DBB" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#F75464" } }
  ]
}
