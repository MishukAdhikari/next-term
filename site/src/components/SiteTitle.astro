---
// The header's name: Next Term, and under it to the right, smaller, what it is. "Your" agents: Next Term
// has no AI of its own; you run the ones you use (Claude Code, Codex, Gemini CLI and the rest) in its tabs.
// Page titles in the browser tab stay "… — Next Term" (Starlight's `title`), short for search results.
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	{config.logo && logos.dark && <img alt={config.logo.alt} src={logos.dark.src} width={logos.dark.width} height={logos.dark.height} />}
	<span class="nt-wordmark" translate="no">
		<span class="nt-name">{siteTitle}</span>
		<span class="nt-descriptor" title="Claude Code, Codex, Gemini CLI and any other coding agent you use: Next Term has no AI of its own">
			the IDE for your AI agents
		</span>
	</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: var(--sl-nav-gap);
			font-size: var(--sl-text-h4);
			font-weight: 600;
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
		img {
			height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
			width: auto;
			max-width: 100%;
			object-fit: contain;
			object-position: 0 50%;
		}
	}
	/* The name on top; the descriptor smaller, starting under "Term" and running to the right. */
	.nt-wordmark {
		display: inline-flex;
		flex-direction: column;
		line-height: 1.1;
		min-width: 0;
	}
	.nt-descriptor {
		align-self: flex-start;
		margin-inline-start: 3.25em;
		margin-top: 0.15rem;
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		color: var(--sl-color-gray-3);
	}
	/* A phone's header has room for the name only. */
	@media (max-width: 30rem) {
		.nt-descriptor {
			display: none;
		}
	}
</style>
