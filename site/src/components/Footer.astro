---
// Starlight's footer (edit link, last updated, previous and next), then the site's own links.
import Default from '@astrojs/starlight/components/Footer.astro';
import { AUTHOR, AUTHOR_URL, DOWNLOAD_DMG, LICENSE_URL, REPO, VERSION } from '../config';
---

<Default />

<div class="site-footer not-content">
	<nav aria-label="Site">
		<ul>
			<li><a href={DOWNLOAD_DMG}>Download Next Term {VERSION}</a></li>
			<li><a href="/docs/">Documentation</a></li>
			<li><a href={REPO}>Source code on GitHub</a></li>
			<li><a href={`${REPO}/releases`}>All releases</a></li>
			<li><a href={`${REPO}/issues`}>Report an issue</a></li>
			<li><a href="/llms.txt">llms.txt</a></li>
		</ul>
	</nav>
	<p>
		Next Term is free and open source under the <a href={LICENSE_URL}>MIT licence</a>. Made by{' '}
		<a href={AUTHOR_URL}>{AUTHOR}</a>. This site uses no cookies, no trackers and no third-party
		requests.
	</p>
</div>

<style>
	.site-footer {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-hairline-light);
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		line-height: 1.45;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin: 0 0 1rem;
		padding: 0;
		list-style: none;
	}
	a {
		color: var(--sl-color-gray-2);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}
	a:hover {
		color: var(--sl-color-white);
	}
	p {
		max-width: 68ch;
		margin: 0;
	}
</style>
