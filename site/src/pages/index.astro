---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Image } from 'astro:assets';
import { LinkButton } from '@astrojs/starlight/components';
import proposalShot from '../assets/screenshots/proposal-window.webp';
import tabsShot from '../assets/screenshots/tab-status.webp';
import claudeShot from '../assets/screenshots/claude-selection.webp';
import diffShot from '../assets/screenshots/diff.webp';
import {
	AUTHOR,
	AUTHOR_URL,
	MIN_MACOS,
	RELEASE_NOTES,
	DOWNLOAD_DMG,
	DOWNLOAD_SHA256,
	RELEASES_LATEST,
	REPO,
	SUMMARY,
	TAGLINE,
	VERSION,
} from '../config';
import { jsonLd } from '../lib/structured-data';

const site = Astro.site!;
const home = new URL('/', site).href;
const pageTitle = 'Next Term — the missing IDE for the terminal';
const description =
	'The missing IDE for the terminal: a free, open-source macOS IDE for AI coding agents. Run Claude Code, Codex and Gemini CLI side by side, with live status.';

const head = [
	{ tag: 'title' as const, content: pageTitle },
	{ tag: 'meta' as const, attrs: { property: 'og:title', content: pageTitle } },
	{ tag: 'meta' as const, attrs: { property: 'og:type', content: 'website' } },
	jsonLd({
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Next Term',
		url: home,
		description,
		inLanguage: 'en',
		publisher: { '@type': 'Person', name: AUTHOR, url: AUTHOR_URL },
	}),
	jsonLd({
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'Next Term',
		description: SUMMARY,
		url: home,
		image: new URL('/icon-512.png', site).href,
		screenshot: new URL('/og.jpg', site).href,
		applicationCategory: 'DeveloperApplication',
		applicationSubCategory: 'IDE for AI coding agents',
		keywords: 'AI IDE, IDE for AI coding agents, AI coding agents, agentic coding, Claude Code, Codex, Gemini CLI, MCP, terminal, code editor, macOS',
		operatingSystem: MIN_MACOS.replace(' or later', '+'),
		softwareVersion: VERSION,
		downloadUrl: DOWNLOAD_DMG,
		releaseNotes: RELEASE_NOTES,
		fileSize: '3MB',
		license: 'https://opensource.org/license/mit',
		isAccessibleForFree: true,
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		author: { '@type': 'Person', name: AUTHOR, url: AUTHOR_URL },
		sameAs: [REPO],
		featureList: [
			'Status for every terminal tab: working, done, or waiting on your decision',
			'Notifications when an agent needs a decision',
			'Claude Code IDE integration: live selection, @-mentions, proposed edits as diffs',
			'Gemini CLI and Qwen Code IDE integration',
			'Send to Agent (⌥⌘K) in each agent’s own syntax',
			'MCP server for orchestration: one agent starts, prompts, waits for and reads the others across projects',
			'Split panes',
			'Go to File: fuzzy search for any file in the project',
			'Code editor for 112 languages',
			'Side-by-side git diffs with hunk staging',
			'Project sidebar with git status and line counts',
			'Find and Replace in Files',
			'nxtrm command-line tool',
			'Checksum-verified self-updates',
		],
	}),
];

const agentsLinked = ['Claude Code', 'Gemini CLI', 'Qwen Code'];
const agentsOthers = [
	'Codex',
	'Command Code',
	'Junie',
	'opencode',
	'Aider',
	'Amp',
	'Cursor Agent',
	'Goose',
	'Crush',
	'GitHub Copilot CLI',
	'Droid',
	'Kiro',
	'Amazon Q',
	'Kimi',
	'Plandex',
	'Cline',
	'Auggie',
];

const mcpTools = [
	'list_tabs',
	'read_tab',
	'wait_for_tab',
	'list_projects',
	'get_editor_selection',
	'get_open_files',
	'open_project',
	'new_tab',
	'send_to_tab',
	'press_keys',
	'show_tab',
	'close_tab',
	'open_in_editor',
];

const faq = [
	{
		q: 'Is Next Term free?',
		a: 'Yes. It is free and open source under the MIT licence, with no account and no paid tier. The source is on GitHub.',
	},
	{
		q: 'Does it come with its own AI?',
		a: 'No. Next Term runs the agent command-line tools you already use, such as Claude Code, Codex and Gemini CLI, signed in the way each of them normally is.',
	},
	{
		q: 'Does Next Term send my code anywhere?',
		a: 'No. The agent links listen only on your Mac, with a fresh token each launch, and never share .env files or keys. The only request Next Term makes on its own is a daily update check to GitHub, which you can turn off.',
	},
	{
		q: 'Can one agent control the others?',
		a: 'Yes. Next Term is an MCP server, set up for you in Claude Code, Codex, Gemini CLI and seven other agents. An orchestrator can list every tab with its agent’s state, start agents, send them prompts, wait for them and read their screens. It works only on your Mac, and Settings turns it off.',
	},
	{
		q: 'Is it an alternative to Warp?',
		a: 'For agent work on the Mac, yes. Both are open source now (Warp’s client under AGPL since April 2026, Next Term under MIT). Next Term is the smaller, native one: Swift and AppKit, no account and no AI of its own. It runs the agent CLIs you choose and adds status for every tab, a code editor, diffs, a git-aware sidebar and an MCP server through which one agent runs the others.',
	},
	{
		q: 'Why does macOS ask me to allow the first launch?',
		a: 'Releases are not notarized by Apple yet. Allow Next Term once with Open Anyway in System Settings → Privacy & Security (macOS 15 and later), or right-click › Open (macOS 13 and 14).',
	},
];
---

<StarlightPage
	frontmatter={{
		title: 'Next Term',
		description,
		template: 'splash',
		head,
		editUrl: false,
		lastUpdated: false,
		prev: false,
		next: false,
		tableOfContents: false,
		hero: {
			title: `<span class="hero-eyebrow">Next Term<span class="sr-only">:</span></span> ${TAGLINE}`,
			tagline:
				'A native macOS terminal and code editor for running AI coding agents side by side. Claude Code, Codex, Gemini CLI and the rest each get a tab, and every tab shows whether its agent is working, done, or waiting on you.',
			actions: [
				{ text: 'Download for macOS', link: DOWNLOAD_DMG, variant: 'primary', icon: 'download' },
				{ text: 'View on GitHub', link: REPO, variant: 'secondary', icon: 'github' },
			],
		},
	}}
>
	<div class="landing not-content">
		<p class="facts">
			<span>Version {VERSION}</span>
			<span>Free and open source (MIT)</span>
			<span>{MIN_MACOS}</span>
			<span>Apple Silicon and Intel</span>
			<span>3 MB download</span>
		</p>

		<figure class="shot shot--hero">
			<Image
				src={proposalShot}
				alt="The Next Term window: a project sidebar with git line counts on the left, and a diff tab where Claude proposes changes to main.php, old on the left and new on the right, with Reject and Accept buttons. Terminal tabs run along the bottom."
				loading="eager"
				fetchpriority="high"
				widths={[800, 1200, 1600]}
				sizes="(min-width: 72rem) 67.5rem, 100vw"
			/>
			<figcaption>
				Claude Code proposes an edit; Next Term shows it as a side-by-side diff. Accept with <kbd>⌘↩︎</kbd>,
				or Reject.
			</figcaption>
		</figure>

		<section class="band band--problem" aria-labelledby="problem">
			<div class="band__text">
				<h2 id="problem">Five agents, five tabs. Which one needs you?</h2>
				<p>
					Running agents in parallel is fast until you lose track of them. One is still thinking, one finished
					ten minutes ago, one has been waiting for your “yes” the whole time. A plain terminal shows five
					identical tabs.
				</p>
				<p>
					Next Term reads each agent’s own screen and marks its tab: a spinner while it works, a green check
					when it is done, an amber “!” when it is asking you something. When an agent needs a decision, a
					notification says so and takes you to the tab.
				</p>
			</div>
			<figure class="shot shot--strip">
				<Image
					src={tabsShot}
					alt="A row of terminal tabs: two plain shells, then a green check, a red cross, an amber exclamation mark and a blue spinner."
					widths={[800, 1613]}
					sizes="(min-width: 72rem) 67.5rem, 100vw"
				/>
			</figure>
		</section>

		<section class="band" aria-labelledby="status">
			<h2 id="status">Know which agent needs you</h2>
			<ul class="features">
				<li>
					<h3>Status in step with the agent</h3>
					<p>
						A spinner only while an agent is really working, read from its own screen, so it stops the moment
						Claude or Codex stops. Plain commands end with a check or a red cross.
					</p>
				</li>
				<li>
					<h3>Decisions come to you</h3>
					<p>
						When an agent asks for permission, a notification quotes the question. Click it to land on that
						tab.
					</p>
				</li>
				<li>
					<h3>However you start it</h3>
					<p>
						Directly, through an alias or a shell function, with <code>npx</code>, or as{' '}
						<code>cd app && claude</code>. Your zsh setup loads exactly as before.
					</p>
				</li>
				<li>
					<h3>A count on the Dock</h3>
					<p>The Dock badge shows how many tabs finished while you were in another app.</p>
				</li>
			</ul>
			<p class="more"><a href="/docs/agent-status/">How agent status works</a></p>
		</section>

		<section class="band band--split" aria-labelledby="editor-link">
			<div>
				<h2 id="editor-link">Your agents see your editor</h2>
				<ul class="features features--stack">
					<li>
						<h3>Claude Code’s IDE link, built in</h3>
						<p>
							Select lines and Claude gets them with your next prompt (“⧉ 10 lines selected”). Nothing to
							install or configure.
						</p>
					</li>
					<li>
						<h3>Edits you approve</h3>
						<p>
							Claude’s proposed changes open as a side-by-side diff. Accept with <kbd>⌘↩︎</kbd>, or Reject.
							Gemini CLI and Qwen Code work the same way.
						</p>
					</li>
					<li>
						<h3>Send to Agent, for every agent</h3>
						<p>
							<kbd>⌥⌘K</kbd> types your selection or files into the agent’s prompt in its own syntax:{' '}
							<code>@app/User.php#L10-20</code> for Claude, <code>app/User.php:10-20</code> for Codex. It
							never presses Return for you.
						</p>
					</li>
				</ul>
				<p class="more"><a href="/docs/agents/">The IDE link and Send to Agent</a></p>
			</div>
			<figure class="shot">
				<Image
					src={claudeShot}
					alt="Two lines selected in the editor, and Claude Code in the terminal below showing “2 lines selected” in its prompt."
					widths={[700, 1400]}
					sizes="(min-width: 72rem) 34rem, 100vw"
				/>
			</figure>
		</section>

		<section class="band band--mcp" aria-labelledby="orchestrate">
			<h2 id="orchestrate">One agent can run the others</h2>
			<p class="lede">
				Next Term is an MCP server. Ask Claude Code, Codex or any agent that speaks MCP to open your projects,
				start other agents in new tabs, give them their tasks, wait for them and read what they did. You watch
				every tab, and step in whenever you like.
			</p>
			<figure class="ask">
				<figcaption>You ask your agent</figcaption>
				<blockquote>
					<p>
						Open ~/Code/api and ~/Code/web. Start Claude Code in api and Codex in web, give each its task, wait
						for both, and tell me what each one changed.
					</p>
				</blockquote>
			</figure>
			<ul class="features features--grid">
				<li>
					<h3>Sees every tab</h3>
					<p>Every project and tab, with each agent’s state: working, done, failed, or waiting on a decision, with the question.</p>
				</li>
				<li>
					<h3>Acts as you would</h3>
					<p>Opens projects, starts agents in new tabs or split panes, types prompts, presses keys, waits until an agent stops, reads its screen.</p>
				</li>
				<li>
					<h3>Uses the editor</h3>
					<p>Your selection, the open files, and any file opened at a line, for agents with no editor link of their own.</p>
				</li>
				<li>
					<h3>Set up for you</h3>
					<p>
						In Claude Code, Codex, Gemini CLI, Qwen Code, Cursor Agent, opencode, Copilot CLI, Amp, Junie and
						Command Code. Only its own entry is written, comments kept.
					</p>
				</li>
				<li>
					<h3>Asks before it acts</h3>
					<p>Typing into a tab and closing one are marked as destructive, so agents ask first. No agent can type into its own tab.</p>
				</li>
				<li>
					<h3>Private</h3>
					<p>A socket only you can open, and no network port. Settings turns it off and removes the entries.</p>
				</li>
			</ul>
			<ul class="tools" aria-label="The 13 MCP tools">
				{mcpTools.map((tool) => <li><code>{tool}</code></li>)}
			</ul>
			<p class="more"><a href="/docs/orchestration/">Orchestrate agents (MCP)</a></p>
		</section>

		<section class="band band--split band--reverse" aria-labelledby="workbench">
			<div>
				<h2 id="workbench">An editor where the agents work</h2>
				<ul class="features features--stack">
					<li>
						<h3>A real code editor</h3>
						<p>
							Above the terminal: 112 languages, soft wrap, <kbd>⌘P</kbd> to go to any file, <kbd>⌘/</kbd> to
							comment, <kbd>⌘L</kbd> to go to a line. When an agent changes an open file, the editor follows.
						</p>
					</li>
					<li>
						<h3>Changes side by side</h3>
						<p>
							<kbd>⌥⌘G</kbd> shows old beside new, changed words marked. Stage, unstage or revert one hunk at a
							time; each action checks the file first, so an agent’s edit is never overwritten.
						</p>
					</li>
					<li>
						<h3>Git at a glance</h3>
						<p>
							The project sidebar colours changed files and shows <span class="counts"
								><span class="plus">+12</span> <span class="minus">−3</span></span
							> per file and folder, like a pull request, with the branch and ahead/behind at the top.
						</p>
					</li>
					<li>
						<h3>Find and Replace in Files</h3>
						<p>
							<kbd>⇧⌘F</kbd> and <kbd>⇧⌘R</kbd> across the project, with regular expressions, file masks and a
							preview of every replacement.
						</p>
					</li>
				</ul>
				<p class="more"><a href="/docs/editor/">The editor</a> · <a href="/docs/diffs/">Diffs</a> · <a href="/docs/projects-and-git/">Projects and git</a></p>
			</div>
			<figure class="shot">
				<Image
					src={diffShot}
					alt="A side-by-side diff of diff.txt against HEAD, with All Changes, Unstaged and Staged views, +2 −2, and a Revert Hunk button."
					widths={[700, 1400]}
					sizes="(min-width: 72rem) 34rem, 100vw"
				/>
			</figure>
		</section>

		<section class="band" aria-labelledby="fit">
			<h2 id="fit">Made to fit how you work</h2>
			<ul class="features features--grid">
				<li>
					<h3>Split panes</h3>
					<p>
						<kbd>⌘D</kbd> splits a tab right, <kbd>⇧⌘D</kbd> down; <kbd>⌥⌘</kbd> and the arrows move between
						panes. The tab shows the mark of the pane that most needs you.
					</p>
				</li>
				<li>
					<h3>Go to File</h3>
					<p><kbd>⌘P</kbd> and a few letters: <code>usrctl</code> finds <code>UserController.php</code>. Add <code>:42</code> for the line.</p>
				</li>
				<li>
					<h3>Your layout</h3>
					<p>The terminal below, beside or above the editor; the sidebar on the left or right.</p>
				</li>
				<li>
					<h3><code>nxtrm</code> in any terminal</h3>
					<p><code>nxtrm .</code> opens a project; <code>nxtrm app/User.php:42</code> opens a file at a line.</p>
				</li>
				<li>
					<h3>Every shortcut is yours</h3>
					<p>Change any of them in Settings (<kbd>⌘,</kbd>).</p>
				</li>
				<li>
					<h3>Updates in one click</h3>
					<p>Checked against the published SHA-256 before anything is replaced.</p>
				</li>
			</ul>
		</section>

		<section class="band" aria-labelledby="works-with">
			<h2 id="works-with">Works with the agents you already use</h2>
			<p class="lede">
				Next Term brings no AI of its own and needs no account. It runs the agent command-line tools you
				install, and anything else you run in a terminal: tests, dev servers, ssh.
			</p>
			<div class="agents">
				<div>
					<h3>Connected as their IDE</h3>
					<p class="hint">Status, live selection, proposed edits as diffs, MCP tools, Send to Agent</p>
					<ul class="chips">
						{agentsLinked.map((name) => <li class="chip chip--strong">{name}</li>)}
					</ul>
				</div>
				<div>
					<h3>Recognised by name</h3>
					<p class="hint">Status on the tab, decisions as notifications, Send to Agent; MCP tools set up for Codex, Cursor Agent, opencode, Copilot CLI, Amp, Junie and Command Code</p>
					<ul class="chips">
						{agentsOthers.map((name) => <li class="chip">{name}</li>)}
					</ul>
				</div>
			</div>
		</section>

		<section class="band" aria-labelledby="privacy">
			<h2 id="privacy">Local by design</h2>
			<ul class="features features--grid">
				<li>
					<h3>Your code stays on your Mac</h3>
					<p>The agent links listen on <code>127.0.0.1</code> only and refuse browsers; the MCP server uses a private socket, with no network port.</p>
				</li>
				<li>
					<h3>A fresh token every launch</h3>
					<p>A new 256-bit secret each time Next Term starts. <code>.env</code> files and keys are never shared.</p>
				</li>
				<li>
					<h3>No account, no telemetry</h3>
					<p>The only request Next Term makes on its own is a daily update check to GitHub. You can turn it off.</p>
				</li>
				<li>
					<h3>Open source, MIT</h3>
					<p>
						Read every line on GitHub. Releases are built from it by GitHub Actions, with a SHA-256 checksum
						for every download.
					</p>
				</li>
			</ul>
			<p class="more"><a href="/docs/security-and-privacy/">Security and privacy in detail</a></p>
		</section>

		<section class="band band--install" aria-labelledby="install">
			<h2 id="install">Install in a minute</h2>
			<p class="oneliner-intro">In one line, from the terminal:</p>
			<pre class="oneliner"><code>curl -fsSL https://next-term.mishuk.me/install.sh | bash</code></pre>
			<p class="hint">
				It checks the release’s SHA-256 and signature and copies Next Term to Applications,
				with no <code>sudo</code> and no first-launch prompt. <a href="https://github.com/MishukAdhikari/next-term/blob/main/site/public/install.sh">Read the script</a>.
				Or with the disk image:
			</p>
			<ol class="steps">
				<li>
					<strong><a href={DOWNLOAD_DMG}>Download NextTerm.dmg</a></strong>, the latest version ({VERSION}),
					straight from its <a href={RELEASES_LATEST}>release on GitHub</a>.
				</li>
				<li><strong>Open it</strong> and drag Next Term to Applications.</li>
				<li>
					<strong>Allow the first launch.</strong> Releases are not notarized yet. On macOS 15 and later, open
					Next Term once, then go to System Settings → Privacy & Security and click <strong>Open Anyway</strong>.
					On macOS 13 and 14, right-click the app, choose <strong>Open</strong>, then <strong>Open</strong> again.
				</li>
				<li>
					<strong>Choose a folder</strong> to work in. Next Term opens it as a project, and reopens it next time.
				</li>
			</ol>
			<p class="hint">
				Optional: download <a href={DOWNLOAD_SHA256}>its checksum</a> next to it and check it with <code>shasum -a 256 -c NextTerm.dmg.sha256</code>.
				After this, Next Term updates itself.
			</p>
			<p class="more"><a href="/docs/getting-started/">The full install guide</a></p>
		</section>

		<section class="band band--next" aria-labelledby="next">
			<h2 id="next">What comes next</h2>
			<ul class="next">
				<li>
					<span class="nt-soon">Coming next</span> <strong>Tabs on your servers.</strong> Connect a VPS over SSH and run
					agents there in tabs that keep running while your Mac is away.
				</li>
				<li>
					<span class="nt-soon">Coming later</span> <strong>Remote access to the MCP server</strong> for agents that
					do not run on your Mac, such as ChatGPT and Claude on the web, through a secure link.
				</li>
			</ul>
		</section>

		<section class="band" aria-labelledby="faq">
			<h2 id="faq">Questions</h2>
			<div class="faq">
				{
					faq.map(({ q, a }) => (
						<details>
							<summary>{q}</summary>
							<p>{a}</p>
						</details>
					))
				}
			</div>
			<p class="more"><a href="/docs/faq/">All questions and answers</a></p>
		</section>

		<section class="cta" aria-labelledby="cta">
			<h2 id="cta">Run your agents side by side</h2>
			<p>Version {VERSION} for {MIN_MACOS}. Free, open source, about a minute to install.</p>
			<div class="cta__actions">
				<LinkButton href={DOWNLOAD_DMG} variant="primary" icon="download">Download for macOS</LinkButton>
				<LinkButton href="/docs/" variant="secondary">Read the documentation</LinkButton>
			</div>
		</section>
	</div>
</StarlightPage>

<style is:global>
	/* The home and 404 heroes: calmer than Starlight’s default, left-aligned on wide screens. */
	[data-has-hero] .hero {
		padding-block: clamp(2rem, calc(1rem + 6vmin), 5rem) 1rem;
	}
	/* Left-aligned at every width: centred paragraphs are hard to read. */
	[data-has-hero] .hero .stack {
		text-align: start;
	}
	[data-has-hero] .hero .copy {
		align-items: flex-start;
	}
	[data-has-hero] .hero .actions {
		justify-content: flex-start;
		gap: 0.75rem 1rem;
	}
	[data-has-hero] .hero h1 {
		font-weight: 700;
		letter-spacing: -0.02em;
		max-width: 16ch;
	}
	[data-has-hero] .hero .tagline {
		max-width: 60ch;
		line-height: 1.45;
		color: var(--sl-color-gray-2);
	}
	.hero-eyebrow {
		display: block;
		margin-bottom: 0.6rem;
		color: var(--sl-color-text-accent);
		font-size: var(--sl-text-base);
		font-weight: 600;
		letter-spacing: 0;
	}
	@media (min-width: 50rem) {
		[data-has-hero] .hero {
			grid-template-columns: 100%;
		}
	}
</style>

<style>
	.landing {
		--gap: clamp(3.5rem, 8vw, 6rem);
