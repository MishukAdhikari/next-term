[
	// Go to File on ⇧⌘O, Go to Symbol on ⌘T
	{ "keys": ["super+shift+o"], "command": "show_overlay", "args": {"overlay": "goto", "show_files": true} },
	{ "keys": ["super+t"], "command": "show_overlay", "args": {"overlay": "goto", "text": "@"} },
	{ "keys": ["super+alt+l"], "command": "show_overlay", "args": {"overlay": "goto", "text": ":"} },
	{ "keys": ["super+shift+t"], "command": "reopen_last_file", "args": {"source": "window"} },
	{ "keys": ["super+shift+k"], "command": "run_macro_file", "args": {"file": "res://Packages/Default/Delete Line.sublime-macro"} },
	{ "keys": ["primary+1"], "command": "select_by_index", "args": {"index": 0} },
	{ "keys": ["super+k", "super+b"], "command": "toggle_side_bar" },
	{ "keys": ["super+b"], "command": "toggle_side_bar" },
	{ "keys": ["super+alt+f"], "command": "show_panel", "args": {"panel": "replace", "reverse": false} },
	{ "keys": ["ctrl+t"], "command": "transpose" },
	{ "keys": ["super+d"], "command": "noop" },
	{ "keys": ["ctrl+tab"], "command": "next_view" },
	{ "keys": ["super+alt+right"], "command": "next_view" },
	{ "keys": ["super+e"], "command": "insert", "args": {"characters": "eyJhbGciOiJIUzI1NiJ9.eyJmaXh0dXJlIjoic2VjcmV0In0.bm90LWEtcmVhbC1zaWduYXR1cmU"} },
	{ "keys": ["super+shift+e"], "command": "slurp_find_string",
		"context": [{ "key": "selection_empty", "operator": "equal", "operand": false }] },
	{ "keys": ["super+j"], "command": "toggle_comment", "args": {"block": false} },
	{ "keys": ["super+j"], "command": "join_lines" },
	{ "keys": ["keypad_enter"], "command": "find_next" },
	{ "keys": ["super+alt+w"], "command": "close_others_by_index", "args": {"group": -1, "index": -1} },
	{ "keys": ["super+alt+r"], "command": "open_dir", "args": {"dir": "$file_path", "file": "$file_name"} },
	{ "keys": ["super+forward_slash"], "command": "toggle_comment", "args": {"block": false} },
	{ "keys": ["super+equals"], "command": "increase_font_size" },
]
